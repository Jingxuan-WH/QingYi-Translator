<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only used for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Translator</AssemblyName>
    <RootNamespace>Translator</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>轻译</Product>
    <AssemblyTitle>轻译</AssemblyTitle>
    <Version>0.3.0</Version>
    <!-- WFO0003 asks WinForms apps to move DPI settings out of app.manifest; this is a WPF app, which needs them there. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- tests/ is a separate project (tests/Translator.Tests) and must not be compiled into the exe. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms/GDI+ namespaces out of the global usings so they don't clash with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- File translation: PdfPig (Apache-2.0) reads PDF text and layout, PDFsharp (MIT) writes the translated PDF.
         PDFsharp is pinned: from 6.5.0 on it is licensed under the AGPL, which this MIT project can't use. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <!-- PDFsharp 6.2.4 asks for 8.0.1, which has known vulnerabilities; this patched version replaces it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
