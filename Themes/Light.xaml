<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette. Dark.xaml defines the same keys; the app swaps the two at runtime,
         so everything that uses them must reference them with DynamicResource. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4F5BD5"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4450C6"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3943AC"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4F5BD5"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EDEFFC"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#4F5BD5"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OutputBrush" Color="#F7F8FB"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E2E6ED"/>
    <SolidColorBrush x:Key="InputLineBrush" Color="#D3D9E2"/>
    <SolidColorBrush x:Key="InputHoverLineBrush" Color="#B9C1CD"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E2E6EE"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E2430"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F6878"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#98A0AE"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#D13B3B"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#9A2B2B"/>
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FCEFEF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D13B3B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D99A00"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E9E5A"/>
    <SolidColorBrush x:Key="SwitchOffBorderBrush" Color="#8A93A3"/>
    <SolidColorBrush x:Key="SwitchOffKnobBrush" Color="#5C6575"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9CFD9"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#AAB2BF"/>
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#8E97A6"/>
    <SolidColorBrush x:Key="ToolTipBrush" Color="#2B3140"/>
    <SolidColorBrush x:Key="ToolTipTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BackdropBrush" Color="#291E2430"/>
    <Color x:Key="ShadowColor">#1E2430</Color>

</ResourceDictionary>
