<Window x:Class="Translator.Views.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Translator.Views"
        Title="{v:T 术语表, En=Glossary}"
        Width="660" Height="620" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="/Assets/app.ico">

    <Window.Resources>
        <Style x:Key="CellBox" TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
            <Setter Property="MinHeight" Value="32"/>
            <EventSetter Event="KeyDown" Handler="Cell_KeyDown"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Flagged}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CellPlaceholder" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SourceCell" Style="{StaticResource CellBox}"
                         Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{v:T 术语, En=Term}"/>
                <TextBlock x:Name="SourcePlaceholder" Style="{StaticResource CellPlaceholder}" Visibility="Collapsed"
                           Text="{v:T '术语，例如 power flow', En='Term, e.g. power flow'}"/>
                <TextBlock Grid.Column="1" Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                <TextBox x:Name="TargetCell" Grid.Column="2" Style="{StaticResource CellBox}"
                         Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{v:T 译法, En=Translation}"/>
                <TextBlock x:Name="TargetPlaceholder" Grid.Column="2" Style="{StaticResource CellPlaceholder}" Visibility="Collapsed"
                           Text="{v:T '译法，例如 潮流', En='Translation, e.g. 潮流'}"/>
                <Button x:Name="DeleteButton" Grid.Column="3" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12"
                        HorizontalAlignment="Right" Content="&#xE74D;" IsTabStop="False" Tag="{Binding}"
                        ToolTip="{v:T 删除, En=Delete}" AutomationProperties.Name="{v:T 删除, En=Delete}" Click="DeleteRow_Click"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="">
                    <Setter TargetName="SourcePlaceholder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Target}" Value="">
                    <Setter TargetName="TargetPlaceholder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBlank}" Value="True">
                    <Setter TargetName="DeleteButton" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Intro and on/off switch -->
        <DockPanel Margin="24,16,24,0">
            <CheckBox x:Name="EnabledToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top"
                      Margin="16,2,0,0" Content="{v:T 启用, En=On}" AutomationProperties.AutomationId="GlossaryEnabledToggle"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0" FontSize="12.5" LineHeight="19"
                       Text="{v:T '原文里出现下面的术语时，会按你指定的译法翻译。每条都双向生效：例如“power flow = 潮流”在英译中和中译英时都会用到。可以直接从 Excel 复制两列粘贴进来。', En='When a term below appears in your text, it’s translated the way you set here. Entries work both ways: “power flow = 潮流” is used for English → Chinese and Chinese → English. You can paste two columns straight from Excel.'}"/>
        </DockPanel>

        <!-- Search and import / export -->
        <DockPanel Grid.Row="1" Margin="24,14,24,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource LinkButton}" FontSize="13" Content="{v:T 导入…, En='Import…'}"
                        AutomationProperties.AutomationId="ImportButton" Click="ImportButton_Click"/>
                <Button Style="{StaticResource LinkButton}" FontSize="13" Margin="16,0,0,0" Content="{v:T 导出…, En='Export…'}"
                        AutomationProperties.AutomationId="ExportButton" Click="ExportButton_Click"/>
            </StackPanel>
            <Grid Width="240" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox" Style="{StaticResource FormTextBox}" Padding="30,0,8,0"
                         AutomationProperties.AutomationId="GlossarySearchBox" AutomationProperties.Name="{v:T 搜索术语, En='Search terms'}"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="11,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}"/>
                <TextBlock x:Name="SearchPlaceholder" Text="{v:T 搜索术语, En='Search terms'}" FontSize="13" Margin="31,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}"/>
            </Grid>
            <TextBlock x:Name="CountText" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}" AutomationProperties.AutomationId="GlossaryCountText"/>
        </DockPanel>

        <!-- Column headings -->
        <Grid Grid.Row="2" Margin="26,0,24,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{v:T 术语, En=Term}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Grid.Column="2" Text="{v:T 译法, En=Translation}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Grid>

        <!-- Entries -->
        <ItemsControl x:Name="RowsList" Grid.Row="3" ItemTemplate="{StaticResource RowTemplate}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                      KeyboardNavigation.TabNavigation="Continue"
                      AutomationProperties.AutomationId="GlossaryRows"
                      DataObject.Pasting="Rows_Pasting">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="RowsScroller" Focusable="False" CanContentScroll="True" Padding="24,0,14,8"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Footer -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="{v:T 取消, En=Cancel}" IsCancel="True"
                            AutomationProperties.AutomationId="GlossaryCancelButton"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{v:T 保存, En=Save}" Margin="10,0,0,0"
                            AutomationProperties.AutomationId="GlossarySaveButton" Click="SaveButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="MessageText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0"
                           AutomationProperties.AutomationId="GlossaryMessage"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
