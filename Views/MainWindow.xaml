<Window x:Class="Translator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Translator.Views"
        Title="{v:T 轻译, En='QingYi Translator'}"
        Width="980" Height="620" MinWidth="640" MinHeight="420"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="/Assets/app.ico">

    <Window.Resources>
        <DataTemplate x:Key="LanguageItemTemplate">
            <TextBlock Text="{Binding DisplayName}"/>
        </DataTemplate>

        <!-- Languages drop down as a three-column grid, like DeepL. -->
        <ItemsPanelTemplate x:Key="LanguageGridPanel">
            <UniformGrid Columns="3"/>
        </ItemsPanelTemplate>

        <Style x:Key="HistoryItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="18,10,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="HistoryItem_MouseLeftButtonUp"/>
            <EventSetter Event="KeyDown" Handler="HistoryItem_KeyDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HistoryItemTemplate">
            <Grid>
                <StackPanel Margin="0,0,30,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="{Binding LanguagePairText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding SourcePreview}" Margin="0,5,0,0" FontSize="13" MaxHeight="38"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding TranslationPreview}" Margin="0,3,0,0" FontSize="13" MaxHeight="38"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12"
                        Content="&#xE74D;" ToolTip="{v:T 删除这条记录, En='Delete this entry'}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="Hidden" Tag="{Binding}" Click="DeleteHistoryItem_Click"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Height="52" Margin="20,0,14,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="译" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{v:T 轻译, En=QingYi}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Grid Margin="34,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8C1;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{v:T 翻译文本, En='Translate text'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Height="2" VerticalAlignment="Bottom" Margin="-2,0,-2,-1" CornerRadius="1"
                                Background="{DynamicResource AccentTextBrush}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Style="{StaticResource PillButton}" Margin="0,0,10,0" Visibility="Collapsed"
                            AutomationProperties.AutomationId="UpdateButton" Click="UpdateButton_Click"/>
                    <ToggleButton x:Name="HistoryButton" Style="{StaticResource IconToggleButton}" Content="&#xE81C;"
                                  ToolTip="{v:T '翻译历史 (Ctrl+H)', En='History (Ctrl+H)'}"
                                  AutomationProperties.AutomationId="HistoryButton" AutomationProperties.Name="{v:T 翻译历史, En=History}"
                                  Checked="HistoryButton_Checked" Unchecked="HistoryButton_Unchecked"/>
                    <Button x:Name="GlossaryButton" Style="{StaticResource IconButton}" Content="&#xE82D;" Margin="4,0,0,0"
                            ToolTip="{v:T 术语表, En=Glossary}"
                            AutomationProperties.AutomationId="GlossaryButton" AutomationProperties.Name="{v:T 术语表, En=Glossary}"
                            Click="GlossaryButton_Click"/>
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggleButton}" Content="&#xE718;" Margin="4,0,0,0"
                                  AutomationProperties.AutomationId="PinButton" AutomationProperties.Name="{v:T 窗口置顶, En='Pin on top'}"
                                  Click="PinButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{v:T 设置, En=Settings}" Margin="4,0,0,0"
                            AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="{v:T 设置, En=Settings}"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Translator card -->
        <Grid Grid.Row="1" Margin="20,16,20,6">
            <Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#1E2430"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Language bar -->
                    <ComboBox x:Name="SourceLangBox" Style="{StaticResource LangComboBox}" Margin="10,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              ItemTemplate="{StaticResource LanguageItemTemplate}"
                              ItemsPanel="{StaticResource LanguageGridPanel}" MaxDropDownHeight="420"
                              AutomationProperties.AutomationId="SourceLangBox" AutomationProperties.Name="{v:T 源语言, En='Source language'}"
                              SelectionChanged="SourceLangBox_SelectionChanged"/>
                    <Button Grid.ColumnSpan="3" Style="{StaticResource IconButton}" Content="&#xE8AB;" ToolTip="{v:T 交换语言, En='Swap languages'}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="SwapButton" AutomationProperties.Name="{v:T 交换语言, En='Swap languages'}"
                            Click="SwapButton_Click"/>
                    <ComboBox x:Name="TargetLangBox" Grid.Column="2" Style="{StaticResource LangComboBox}" Margin="10,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              ItemTemplate="{StaticResource LanguageItemTemplate}"
                              ItemsPanel="{StaticResource LanguageGridPanel}" MaxDropDownHeight="420"
                              AutomationProperties.AutomationId="TargetLangBox" AutomationProperties.Name="{v:T 目标语言, En='Target language'}"
                              SelectionChanged="TargetLangBox_SelectionChanged"/>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource LineBrush}"/>
                    <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource LineBrush}"/>

                    <!-- Source pane -->
                    <Grid Grid.Row="2" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="SourceBox" Style="{StaticResource PaneTextBox}" Padding="20,14,44,8"
                                 AutomationProperties.AutomationId="SourceBox" AutomationProperties.Name="{v:T 原文, En='Source text'}"
                                 TextChanged="SourceBox_TextChanged"/>
                        <StackPanel x:Name="SourcePlaceholder" Margin="22,14,44,0" IsHitTestVisible="False">
                            <TextBlock Text="{v:T 输入或粘贴要翻译的文本, En='Type or paste text to translate'}" FontSize="18"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PlaceholderHint" Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="ClearButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="13" ToolTip="{v:T 清空, En=Clear}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed"
                                AutomationProperties.Name="{v:T 清空, En=Clear}" Click="ClearButton_Click"/>
                        <Grid Grid.Row="1" Height="44" Margin="22,0,10,0">
                            <TextBlock x:Name="CharCountText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Grid>
                    </Grid>

                    <!-- Output pane -->
                    <Border x:Name="OutputPane" Grid.Row="2" Grid.Column="2" Background="{DynamicResource OutputBrush}" CornerRadius="0,0,11,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="OutputBox" Style="{StaticResource PaneTextBox}" Padding="20,14,20,8"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                                     AutomationProperties.AutomationId="OutputBox" AutomationProperties.Name="{v:T 译文, En=Translation}"/>
                            <TextBlock x:Name="OutputPlaceholder" Margin="22,14,20,0" Text="{v:T 译文, En=Translation}" FontSize="18"
                                       Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"/>
                            <Canvas x:Name="LoadingTrack" Height="2" VerticalAlignment="Top" ClipToBounds="True" Visibility="Collapsed">
                                <Rectangle Width="140" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentTextBrush}">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="LoadingShift"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>

                            <Border x:Name="ErrorPanel" Grid.Row="1" Margin="14,0,14,4" Padding="12,9" CornerRadius="8"
                                    Background="{DynamicResource ErrorSoftBrush}" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource ErrorBrush}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                    <Button x:Name="ErrorActionButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                            Content="{v:T 打开设置, En='Open settings'}"
                                            FontSize="13" Margin="12,1,0,0" VerticalAlignment="Top" Click="SettingsButton_Click"/>
                                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ErrorTextBrush}"
                                               AutomationProperties.AutomationId="ErrorText"/>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Row="2" Height="44" Margin="22,0,10,0">
                                <TextBlock x:Name="StatusText" Margin="0,0,80,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="StatusText"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="14"
                                            ToolTip="{v:T '整体重新翻译 (Ctrl+Enter)', En='Retranslate everything (Ctrl+Enter)'}"
                                            AutomationProperties.AutomationId="RetranslateButton" AutomationProperties.Name="{v:T 重新翻译, En=Retranslate}"
                                            Click="RetranslateButton_Click"/>
                                    <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Content="&#xE8C8;" Margin="2,0,0,0"
                                            AutomationProperties.AutomationId="CopyButton" AutomationProperties.Name="{v:T 复制译文, En='Copy translation'}"
                                            Click="CopyButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Height="28" Margin="26,0,26,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"
                        ToolTip="{v:T 更改翻译服务, En='Change translation service'}" MouseLeftButtonUp="EngineStatus_MouseLeftButtonUp">
                <Ellipse x:Name="EngineDot" Width="7" Height="7" VerticalAlignment="Center"/>
                <TextBlock x:Name="EngineText" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="EngineText"/>
            </StackPanel>
            <TextBlock x:Name="ShortcutHintText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
        </Grid>

        <!-- History drawer -->
        <Grid x:Name="HistoryOverlay" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="{DynamicResource BackdropBrush}" MouseLeftButtonDown="HistoryBackdrop_MouseLeftButtonDown"/>
            <Grid HorizontalAlignment="Right" Width="420" Margin="0,12,20,14">
                <Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#1E2430"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="18,12,10,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{v:T 翻译历史, En=History}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="HistoryCountText" Margin="10,1,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="ClearHistoryButton" Style="{StaticResource LinkButton}" Content="{v:T 清空, En='Clear all'}" FontSize="13"
                                        Margin="0,0,12,0" VerticalAlignment="Center" Click="ClearHistoryButton_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="{v:T '关闭 (Esc)', En='Close (Esc)'}"
                                        AutomationProperties.AutomationId="CloseHistoryButton" AutomationProperties.Name="{v:T 关闭翻译历史, En='Close history'}"
                                        Click="CloseHistoryButton_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="18,4,18,10">
                            <TextBox x:Name="HistorySearchBox" Style="{StaticResource FormTextBox}" Padding="30,0,8,0"
                                     AutomationProperties.AutomationId="HistorySearchBox" AutomationProperties.Name="{v:T 搜索翻译历史, En='Search history'}"
                                     TextChanged="HistorySearchBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="11,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock x:Name="HistorySearchPlaceholder" Text="{v:T 搜索原文或译文, En='Search source or translation'}" FontSize="13" Margin="31,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Grid>
                        <ListBox x:Name="HistoryList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource HistoryItem}" ItemTemplate="{StaticResource HistoryItemTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.AutomationId="HistoryList" AutomationProperties.Name="{v:T 翻译历史列表, En='History list'}">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Focusable="False" Padding="0,0,0,8">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                        <TextBlock x:Name="HistoryEmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,0,0,40" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
