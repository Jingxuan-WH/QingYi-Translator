<Window x:Class="Translator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻译"
        Width="980" Height="620" MinWidth="640" MinHeight="420"
        WindowStartupLocation="Manual"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="/Assets/app.ico">

    <Window.Resources>
        <DataTemplate x:Key="LanguageItemTemplate">
            <TextBlock Text="{Binding DisplayName}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Height="52" Margin="20,0,14,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="译" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="轻译" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Grid Margin="34,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8C1;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="翻译文本" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Height="2" VerticalAlignment="Bottom" Margin="-2,0,-2,-1" CornerRadius="1"
                                Background="{StaticResource AccentBrush}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggleButton}" Content="&#xE718;" ToolTip="窗口置顶"
                                  AutomationProperties.AutomationId="PinButton" AutomationProperties.Name="窗口置顶"
                                  Click="PinButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" Margin="4,0,0,0"
                            AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="设置"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Translator card -->
        <Grid Grid.Row="1" Margin="20,16,20,6">
            <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#1E2430"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Language bar -->
                    <ComboBox x:Name="SourceLangBox" Style="{StaticResource LangComboBox}" Margin="10,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              ItemTemplate="{StaticResource LanguageItemTemplate}"
                              AutomationProperties.Name="源语言"
                              SelectionChanged="SourceLangBox_SelectionChanged"/>
                    <Button Grid.ColumnSpan="3" Style="{StaticResource IconButton}" Content="&#xE8AB;" ToolTip="交换语言"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="SwapButton" AutomationProperties.Name="交换语言"
                            Click="SwapButton_Click"/>
                    <ComboBox x:Name="TargetLangBox" Grid.Column="2" Style="{StaticResource LangComboBox}" Margin="10,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              ItemTemplate="{StaticResource LanguageItemTemplate}"
                              AutomationProperties.Name="目标语言"
                              SelectionChanged="TargetLangBox_SelectionChanged"/>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource LineBrush}"/>
                    <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource LineBrush}"/>

                    <!-- Source pane -->
                    <Grid Grid.Row="2" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="SourceBox" Style="{StaticResource PaneTextBox}" Padding="20,14,44,8"
                                 AutomationProperties.AutomationId="SourceBox" AutomationProperties.Name="原文"
                                 TextChanged="SourceBox_TextChanged"/>
                        <StackPanel x:Name="SourcePlaceholder" Margin="22,14,44,0" IsHitTestVisible="False">
                            <TextBlock Text="输入或粘贴要翻译的文本" FontSize="18" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PlaceholderHint" Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="ClearButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="13" ToolTip="清空"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed"
                                AutomationProperties.Name="清空" Click="ClearButton_Click"/>
                        <Grid Grid.Row="1" Height="44" Margin="22,0,10,0">
                            <TextBlock x:Name="CharCountText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"/>
                        </Grid>
                    </Grid>

                    <!-- Output pane -->
                    <Border x:Name="OutputPane" Grid.Row="2" Grid.Column="2" Background="{StaticResource OutputBrush}" CornerRadius="0,0,11,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="OutputBox" Style="{StaticResource PaneTextBox}" Padding="20,14,20,8"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                                     AutomationProperties.AutomationId="OutputBox" AutomationProperties.Name="译文"/>
                            <TextBlock x:Name="OutputPlaceholder" Margin="22,14,20,0" Text="译文" FontSize="18"
                                       Foreground="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False"/>
                            <Canvas x:Name="LoadingTrack" Height="2" VerticalAlignment="Top" ClipToBounds="True" Visibility="Collapsed">
                                <Rectangle Width="140" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource AccentBrush}">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="LoadingShift"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>

                            <Border x:Name="ErrorPanel" Grid.Row="1" Margin="14,0,14,4" Padding="12,9" CornerRadius="8"
                                    Background="{StaticResource ErrorSoftBrush}" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource ErrorBrush}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                    <Button x:Name="ErrorActionButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="打开设置"
                                            FontSize="13" Margin="12,1,0,0" VerticalAlignment="Top" Click="SettingsButton_Click"/>
                                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource ErrorTextBrush}"
                                               AutomationProperties.AutomationId="ErrorText"/>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Row="2" Height="44" Margin="22,0,10,0">
                                <TextBlock x:Name="StatusText" Margin="0,0,80,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="StatusText"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="14" ToolTip="重新翻译 (Ctrl+Enter)"
                                            AutomationProperties.AutomationId="RetranslateButton" AutomationProperties.Name="重新翻译"
                                            Click="RetranslateButton_Click"/>
                                    <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="复制译文" Margin="2,0,0,0"
                                            AutomationProperties.AutomationId="CopyButton" AutomationProperties.Name="复制译文"
                                            Click="CopyButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Height="28" Margin="26,0,26,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"
                        ToolTip="更改翻译服务" MouseLeftButtonUp="EngineStatus_MouseLeftButtonUp">
                <Ellipse x:Name="EngineDot" Width="7" Height="7" VerticalAlignment="Center"/>
                <TextBlock x:Name="EngineText" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="ShortcutHintText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextTertiaryBrush}"/>
        </Grid>
    </Grid>
</Window>
