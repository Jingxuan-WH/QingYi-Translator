<Window x:Class="Translator.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Translator.Views"
        Title="{v:T 软件更新, En='Software update'}"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="/Assets/app.ico">
    <StackPanel>
        <StackPanel Margin="24,18,24,18">
            <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="UpdateHeading"/>
            <TextBlock x:Name="SubText" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <Border Margin="0,14,0,0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="8">
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10,8,10">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                               Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.AutomationId="UpdateNotes"/>
                </ScrollViewer>
            </Border>
            <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <ProgressBar x:Name="Progress" Style="{StaticResource ThinProgressBar}" Minimum="0" Maximum="1"/>
                <TextBlock x:Name="ProgressText" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           AutomationProperties.AutomationId="UpdateProgressText"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource ErrorBrush}" AutomationProperties.AutomationId="UpdateError"/>
        </StackPanel>
        <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button x:Name="PageButton" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" FontSize="13" VerticalAlignment="Center"
                        Content="{v:T 在网页中查看, En='View on GitHub'}" Click="PageButton_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SkipButton" Style="{StaticResource SecondaryButton}" Content="{v:T 跳过此版本, En='Skip this version'}"
                            AutomationProperties.AutomationId="SkipUpdateButton" Click="SkipButton_Click"/>
                    <Button x:Name="LaterButton" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" IsCancel="True"
                            AutomationProperties.AutomationId="LaterButton" Click="LaterButton_Click"/>
                    <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" IsDefault="True"
                            Content="{v:T 立即更新, En='Update now'}"
                            AutomationProperties.AutomationId="InstallUpdateButton" Click="InstallButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
