<Window x:Class="Translator.Views.LiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Translator.Views"
        Title="{v:T 实时转录, En='Live transcription'}"
        Width="820" Height="640" MinWidth="600" MinHeight="420"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="/Assets/app.ico">

    <Window.Resources>
        <Style x:Key="LineItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,9,16,9"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LineTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="SourceText" Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TranslationText" Text="{Binding Translation}" FontSize="15" TextWrapping="Wrap" LineHeight="23"
                               Margin="0,3,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TranslatingText" Text="{v:T 正在翻译…, En='Translating…'}" FontSize="13" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFinal}" Value="False">
                    <Setter TargetName="SourceText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                    <Setter TargetName="SourceText" Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TranslationIsDraft}" Value="True">
                    <Setter TargetName="TranslationText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Translation}" Value="">
                    <Setter TargetName="TranslationText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsTranslating}" Value="True"/>
                        <Condition Binding="{Binding Translation}" Value=""/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TranslatingText" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sources, languages and controls -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,12,18,12">
            <StackPanel>
                <WrapPanel>
                    <ComboBox x:Name="SourceBox" Style="{StaticResource FormComboBox}" Width="170" Margin="0,0,10,6" DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="{v:T 音源, En='Audio source'}" ToolTip="{v:T 音源, En='Audio source'}"
                              SelectionChanged="SourceBox_SelectionChanged"/>
                    <ComboBox x:Name="MicrophoneBox" Style="{StaticResource FormComboBox}" Width="230" Margin="0,0,18,6" DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="{v:T 麦克风, En=Microphone}" ToolTip="{v:T 麦克风, En=Microphone}"
                              SelectionChanged="MicrophoneBox_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ComboBox x:Name="SourceLanguageBox" Style="{StaticResource FormComboBox}" Width="150" DisplayMemberPath="DisplayName"
                                  MaxDropDownHeight="420" AutomationProperties.Name="{v:T 说话的语言, En='Spoken language'}"
                                  ToolTip="{v:T 说话的语言, En='Spoken language'}" SelectionChanged="SourceLanguageBox_SelectionChanged"/>
                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="10,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <ComboBox x:Name="TargetLanguageBox" Style="{StaticResource FormComboBox}" Width="150" DisplayMemberPath="DisplayName"
                                  MaxDropDownHeight="420" AutomationProperties.Name="{v:T 目标语言, En='Target language'}"
                                  ToolTip="{v:T 译成, En='Translate into'}" SelectionChanged="TargetLanguageBox_SelectionChanged"/>
                    </StackPanel>
                </WrapPanel>
                <DockPanel Margin="0,6,0,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" MinWidth="96"
                                AutomationProperties.AutomationId="LiveStartButton" Click="StartButton_Click"/>
                        <Button x:Name="PauseButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" MinWidth="72"
                                Content="{v:T 暂停, En=Pause}" AutomationProperties.AutomationId="LivePauseButton" Click="PauseButton_Click"/>
                        <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" MinWidth="72"
                                Content="{v:T 停止, En=Stop}" AutomationProperties.AutomationId="LiveStopButton" Click="StopButton_Click"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="MicLevelPanel" Orientation="Horizontal" ToolTip="{v:T 麦克风音量, En='Microphone level'}">
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ProgressBar x:Name="MicLevel" Style="{StaticResource ThinProgressBar}" Width="70" Margin="6,0,0,0" Maximum="1"/>
                        </StackPanel>
                        <StackPanel x:Name="SystemLevelPanel" Orientation="Horizontal" Margin="14,0,0,0" ToolTip="{v:T 系统声音音量, En='System audio level'}">
                            <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ProgressBar x:Name="SystemLevel" Style="{StaticResource ThinProgressBar}" Width="70" Margin="6,0,0,0" Maximum="1"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Margin="16,0,12,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextTertiaryBrush}" AutomationProperties.AutomationId="LiveStatusText"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Model download, permissions and errors -->
        <Border x:Name="Banner" Grid.Row="1" Margin="18,12,18,0" Padding="14,10" CornerRadius="8" Visibility="Collapsed"
                Background="{DynamicResource AccentSoftBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="BannerLinkButton" Style="{StaticResource LinkButton}" FontSize="13" VerticalAlignment="Center"
                            Margin="0,0,14,0" Visibility="Collapsed" Click="BannerLinkButton_Click"/>
                    <Button x:Name="BannerButton" Style="{StaticResource SecondaryButton}" Padding="14,6" MinWidth="0"
                            AutomationProperties.AutomationId="LiveBannerButton" Click="BannerButton_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="BannerText" FontSize="13" TextWrapping="Wrap" LineHeight="20" AutomationProperties.AutomationId="LiveBannerText"/>
                    <StackPanel x:Name="DownloadOptions" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Text="{v:T 下载源, En='Download from'}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="DownloadSourceBox" Style="{StaticResource FormComboBox}" Width="210" Height="30" Margin="8,0,16,0"
                                  DisplayMemberPath="DisplayName"/>
                        <CheckBox x:Name="GpuDownloadToggle" Style="{StaticResource ToggleSwitch}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar x:Name="BannerProgress" Style="{StaticResource ThinProgressBar}" Margin="0,8,0,0" Maximum="1" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Transcript -->
        <Grid Grid.Row="2" Margin="18,12,18,0">
            <Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <ListBox x:Name="TranscriptList" BorderThickness="0" Background="Transparent" Margin="0,6,0,6"
                         ItemContainerStyle="{StaticResource LineItem}" ItemTemplate="{StaticResource LineTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.AutomationId="LiveTranscriptList" AutomationProperties.Name="{v:T 转录内容, En=Transcript}"
                         ContextMenuOpening="TranscriptList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{v:T 复制原文, En='Copy original'}" Tag="original" Click="CopyLine_Click"/>
                            <MenuItem Header="{v:T 复制译文, En='Copy translation'}" Tag="translation" Click="CopyLine_Click"/>
                            <MenuItem Header="{v:T 复制原文和译文, En='Copy both'}" Tag="both" Click="CopyLine_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer x:Name="Scroller" Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>
            </Border>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0,40,30" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"/>
            <Button x:Name="JumpButton" Style="{StaticResource PillButton}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,14" Visibility="Collapsed" Content="{v:T '↓ 回到最新', En='↓ Jump to latest'}" Click="JumpButton_Click"/>
        </Grid>

        <!-- Options and export -->
        <DockPanel Grid.Row="3" Margin="20,10,18,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ExportButton" Style="{StaticResource SecondaryButton}" Padding="14,6" MinWidth="0"
                        Content="{v:T 导出…, En='Export…'}" AutomationProperties.AutomationId="LiveExportButton" Click="ExportButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ExportMenu">
                            <MenuItem Header="{v:T 'TXT · 原文和译文', En='TXT · original and translation'}" Tag="txt bilingual" Click="ExportItem_Click"/>
                            <MenuItem Header="{v:T 'TXT · 原文', En='TXT · original'}" Tag="txt original" Click="ExportItem_Click"/>
                            <MenuItem Header="{v:T 'TXT · 译文', En='TXT · translation'}" Tag="txt translation" Click="ExportItem_Click"/>
                            <Separator/>
                            <MenuItem Header="{v:T 'SRT 字幕 · 双语', En='SRT subtitles · bilingual'}" Tag="srt bilingual" Click="ExportItem_Click"/>
                            <MenuItem Header="{v:T 'SRT 字幕 · 原文', En='SRT subtitles · original'}" Tag="srt original" Click="ExportItem_Click"/>
                            <MenuItem Header="{v:T 'SRT 字幕 · 译文', En='SRT subtitles · translation'}" Tag="srt translation" Click="ExportItem_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ClearButton" Style="{StaticResource SecondaryButton}" Padding="14,6" MinWidth="0" Margin="8,0,0,0"
                        Content="{v:T 清空, En=Clear}" Click="ClearButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="PartialToggle" Style="{StaticResource ToggleSwitch}" Content="{v:T 临时结果也预翻译, En='Translate partial results too'}"
                          ToolTip="{v:T '说话过程中也翻译还在变化的文字（灰色），会多用一些请求', En='Also translate the text while it is still changing (grey); uses more requests'}"
                          Click="PartialToggle_Click"/>
                <CheckBox x:Name="CaptionsToggle" Style="{StaticResource ToggleSwitch}" Margin="24,0,0,0"
                          Content="{v:T 悬浮字幕, En='Floating captions'}" Click="CaptionsToggle_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
