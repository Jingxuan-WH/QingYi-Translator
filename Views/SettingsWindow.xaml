<Window x:Class="Translator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560" Height="660" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,2,24,20">

                <!-- Translation service -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="翻译服务"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="服务商"/>
                        <ComboBox x:Name="ProviderBox" Style="{StaticResource FormComboBox}" DisplayMemberPath="DisplayName"
                                  SelectionChanged="ProviderBox_SelectionChanged"/>

                        <DockPanel Margin="0,12,0,6">
                            <Button x:Name="KeyLinkButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                    Content="获取 DeepSeek API Key" Click="KeyLinkButton_Click"/>
                            <TextBlock Text="API Key" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </DockPanel>
                        <Grid>
                            <PasswordBox x:Name="KeyBox" Style="{StaticResource FormPasswordBox}" Padding="8,0,40,0"/>
                            <TextBox x:Name="KeyPlainBox" Style="{StaticResource FormTextBox}" Padding="8,0,40,0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="RevealKeyButton" Style="{StaticResource IconToggleButton}" Width="30" Height="28"
                                          FontSize="13" Content="&#xE890;" ToolTip="显示 / 隐藏"
                                          HorizontalAlignment="Right" Margin="0,0,3,0" Click="RevealKeyButton_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Text="API Key 使用 Windows 账户加密后保存在本机，不会上传到其他地方。"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="接口地址"/>
                        <TextBox x:Name="BaseUrlBox" Style="{StaticResource FormTextBox}"/>
                        <TextBlock x:Name="BaseUrlHint" Style="{StaticResource HintText}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="模型"/>
                        <TextBox x:Name="ModelBox" Style="{StaticResource FormTextBox}"/>
                        <ItemsControl x:Name="ModelChips" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButton}" Content="{Binding}" Margin="0,0,8,0" Click="ModelChip_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ModelHint" Style="{StaticResource HintText}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="TestButton" Style="{StaticResource SecondaryButton}" Content="测试连接" Click="TestButton_Click"/>
                            <TextBlock x:Name="TestResult" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       TextWrapping="Wrap" MaxWidth="360"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Shortcuts -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="快捷键"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="DoubleCopyToggle" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                  Content="按两次 Ctrl+C 翻译选中的文字"/>
                        <TextBlock Style="{StaticResource HintText}" Text="与 DeepL 相同：选中文字后按住 Ctrl，快速按两下 C。"/>

                        <CheckBox x:Name="HotkeyToggle" Style="{StaticResource ToggleSwitch}" Margin="0,16,0,0"
                                  Content="使用快捷键翻译选中的文字" Click="HotkeyToggle_Click"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快捷键" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="HotkeyBox" Grid.Column="1" Style="{StaticResource FormTextBox}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                                     InputMethod.IsInputMethodEnabled="False"
                                     ToolTip="点击后按下新的组合键"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                     LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"/>
                        </Grid>
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource HintText}"/>
                    </StackPanel>
                </Border>

                <!-- Preferences -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="翻译偏好"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="附加要求（可选）"/>
                        <Grid>
                            <TextBox x:Name="ExtraBox" Style="{StaticResource FormTextBox}" Height="76" Padding="8,6"
                                     VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" TextChanged="ExtraBox_TextChanged"/>
                            <TextBlock x:Name="ExtraPlaceholder" Margin="11,7,10,0" FontSize="13" TextWrapping="Wrap"
                                       IsHitTestVisible="False" Foreground="{StaticResource TextTertiaryBrush}"
                                       Text="例如：使用学术论文的正式文风；专业术语保留英文原文。"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Text="会附加在给模型的翻译指令后面。"/>
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="常规"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="AutoTranslateToggle" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                  Content="输入时自动翻译"/>
                        <CheckBox x:Name="RestoreClipboardToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                  Content="快捷键取词后恢复剪贴板原来的内容"/>
                        <CheckBox x:Name="CloseToTrayToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                  Content="关闭主窗口时最小化到系统托盘"/>
                        <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                  Content="开机自动启动"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="VersionText" Style="{StaticResource HintText}" Margin="4,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="取消" IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButton}" Content="保存" IsDefault="True" Margin="10,0,0,0" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
